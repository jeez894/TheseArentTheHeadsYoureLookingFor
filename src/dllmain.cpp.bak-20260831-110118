    auto mount_clone_once(VisualMountState& state,
                          UObject* source,
                          UObject* parent,
                          UObject* mesh,
                          VisualOwnerKind kind,
                          const RC::Unreal::TCHAR* reason)
        -> bool
    {
        if (!is_live_object(source) ||
            !is_live_object(parent) ||
            !is_live_object(mesh) ||
            !is_live_object(state.clone))
        {
            return false;
        }

        if (!set_skeletal_mesh(state.clone, mesh))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_failed owner={} reason=set-mesh\n"),
                visual_owner_label(kind));
            return false;
        }

        const auto material_count =
            copy_materials(source, state.clone);

        FName astro_head{};
        FName humanoid_neck{};

        if (!find_exact_bone(
                state.clone,
                STR("Head"),
                astro_head) ||
            !find_exact_bone(
                parent,
                STR("neck_02"),
                humanoid_neck))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_failed owner={} reason=bone-not-found\n"),
                visual_owner_label(kind));
            return false;
        }

        // Allow one pose evaluation while the exact pivot is solved.
        set_component_tick(state.clone, true);

        if (!attach_to_bone(
                state.clone,
                parent,
                humanoid_neck) ||
            !set_relative_rotation(
                state.clone,
                kAstroCloneRotation) ||
            !set_relative_scale(
                state.clone,
                kAstroCloneScale))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_failed owner={} reason=initial-transform\n"),
                visual_owner_label(kind));
            return false;
        }

        FVector56 source_location{};
        FVector56 target_location{};
        FVector56 component_location{};

        if (!get_socket_location(
                state.clone,
                astro_head,
                source_location) ||
            !get_socket_location(
                parent,
                humanoid_neck,
                target_location) ||
            !get_component_location(
                state.clone,
                component_location))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_failed owner={} reason=pivot-read\n"),
                visual_owner_label(kind));
            return false;
        }

        const FVector56 solved_world{
            component_location.X +
                (target_location.X - source_location.X),
            component_location.Y +
                (target_location.Y - source_location.Y),
            component_location.Z +
                (target_location.Z - source_location.Z),
        };

        if (!set_world_location(
                state.clone,
                solved_world))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_failed owner={} reason=pivot-solve\n"),
                visual_owner_label(kind));
            return false;
        }

        // Independent visual prop: no collision and no own animation tick.
        set_collision_disabled(state.clone);
        set_component_tick(state.clone, false);

        set_component_visibility(state.clone, true);
        set_component_visibility(source, false);

        state.source = source;
        state.mesh = mesh;
        state.parent = parent;
        state.active = true;

        RC::Output::send<RC::LogLevel::Verbose>(
            STR("[TheseArentTheHeadsYoureLookingFor] astro_mount_ready owner={} reason={} materials={} rot=(-90,177.5,180) scale=0.60\n"),
            visual_owner_label(kind),
            reason,
            material_count);

        return true;
    }

    auto find_or_create_visual_state(UObject* owner)
        -> VisualMountState&
    {
        for (auto& state : g_visual_mounts)
        {
            if (state.owner == owner)
            {
                return state;
            }
        }

        g_visual_mounts.push_back(
            VisualMountState{
                .owner = owner,
            });

        return g_visual_mounts.back();
    }

    auto trailing_component_generation(
        const RC::StringType& full_name) -> std::uint32_t
    {
        std::uint32_t value = 0;
        std::uint32_t multiplier = 1;
        bool found_digit = false;

        for (auto it = full_name.rbegin();
             it != full_name.rend();
             ++it)
        {
            const auto c = *it;

            if (c < static_cast<RC::Unreal::TCHAR>('0') ||
                c > static_cast<RC::Unreal::TCHAR>('9'))
            {
                break;
            }

            found_digit = true;

            value +=
                static_cast<std::uint32_t>(
                    c - static_cast<RC::Unreal::TCHAR>('0')) *
                multiplier;

            multiplier *= 10;
        }

        return found_digit ? value : 0;
    }

    struct VisualSourceCandidate
    {
        UObject* owner{};
        UObject* source{};
        UObject* parent{};
        UObject* mesh{};
        VisualOwnerKind kind{VisualOwnerKind::Other};
        std::uint32_t generation{};
    };

    auto run_native_astromech_visual_scan() -> void
    {
        if (!g_native_visual_mount_ready ||
            g_skeletal_mesh_component_class == nullptr)
        {
            return;
        }

        for (auto& state : g_visual_mounts)
        {
            state.seen_this_scan = false;
        }

        std::vector<UObject*> components{};
        RC::Unreal::UObjectGlobals::FindAllOf(
            FName(STR("SkeletalMeshComponent"),
                  RC::Unreal::FNAME_Find),
            components);

        std::vector<VisualSourceCandidate> candidates{};

        for (auto* component : components)
        {
            if (!is_live_object(component) ||
                !is_managed_humanoid_face_component(component) ||
                !is_character_mesh_parent(component))
            {
                continue;
            }

            auto* owner = get_outer(component);
            const auto kind = visual_owner_kind(owner);

            if (kind == VisualOwnerKind::Other)
            {
                continue;
            }

            auto* mesh = get_skeletal_mesh(component);

            if (!is_astromech_head_mesh(mesh))
            {
                continue;
            }

            auto* parent =
                get_object_property(component,
                                    STR("AttachParent"));

            if (!is_live_object(parent))
            {
                continue;
            }

            const auto generation =
                trailing_component_generation(
                    component->GetFullName());

            auto existing =
                std::find_if(
                    candidates.begin(),
                    candidates.end(),
                    [owner](const auto& candidate)
                    {
                        return candidate.owner == owner;
                    });

            if (existing == candidates.end())
            {
                candidates.push_back(
                    VisualSourceCandidate{
                        .owner = owner,
                        .source = component,
                        .parent = parent,
                        .mesh = mesh,
                        .kind = kind,
                        .generation = generation,
                    });
            }
            else if (generation >= existing->generation)
            {
                *existing = VisualSourceCandidate{
                    .owner = owner,
                    .source = component,
                    .parent = parent,
                    .mesh = mesh,
                    .kind = kind,
                    .generation = generation,
                };
            }
        }

        for (const auto& candidate : candidates)
        {
            auto& state =
                find_or_create_visual_state(
                    candidate.owner);

            state.seen_this_scan = true;
            state.source = candidate.source;

            // Do NOT hide the game's source until a valid independent clone
            // has been successfully created and mounted. This prevents the
            // failure mode from v0.7.1 where movement made the only visible
            // Astromech head disappear after clone creation failed.
            if (!is_live_object(state.clone))
            {
                state.clone =
                    create_skeletal_mesh_component(
                        candidate.owner,
                        candidate.source,
                        candidate.kind);

                state.active = false;
                state.mesh = nullptr;
                state.parent = nullptr;

                if (!is_live_object(state.clone))
                {
                    set_component_visibility(
                        candidate.source,
                        true);

                    // create_skeletal_mesh_component() already logged the
                    // exact failure stage.
                    continue;
                }

                RC::Output::send<RC::LogLevel::Verbose>(
                    STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_created owner={}\n"),
                    visual_owner_label(candidate.kind));
            }

            // Materials may change even when several CPDs reuse the same
            // SkeletalMesh, so refresh materials every scan.  This is NOT a
            // transform write.
            copy_materials(
                candidate.source,
                state.clone);

            FName expected_socket{
                STR("neck_02"),
                RC::Unreal::FNAME_Find};

            const bool attachment_ok =
                clone_attach_parent_matches(
                    state.clone,
                    candidate.parent) &&
                !expected_socket.IsNone() &&
                clone_attach_socket_matches(
                    state.clone,
                    expected_socket);

            const bool needs_remount =
                !state.active ||
                state.mesh != candidate.mesh ||
                state.parent != candidate.parent ||
                !attachment_ok;

            if (needs_remount)
            {
                const bool mounted =
                    mount_clone_once(
                        state,
                        candidate.source,
                        candidate.parent,
                        candidate.mesh,
                        candidate.kind,
                        state.active
                            ? STR("source-or-parent-changed")
                            : STR("activate"));

                if (!mounted)
                {
                    set_component_visibility(
                        state.clone,
                        false);

                    set_component_visibility(
                        candidate.source,
                        true);

                    state.active = false;
                }
            }
            else
            {
                // Stable path: source stays hidden, clone stays visible,
                // and there are ZERO clone transform writes.
                set_component_visibility(
                    candidate.source,
                    false);

                set_component_visibility(
                    state.clone,
                    true);
            }
        }

        for (auto& state : g_visual_mounts)
        {
            if (!state.seen_this_scan)
            {
                if (is_live_object(state.clone))
                {
                    set_component_visibility(
                        state.clone,
                        false);
                }

                state.active = false;
                state.source = nullptr;
                state.mesh = nullptr;
                state.parent = nullptr;
            }
        }

        g_visual_mounts.erase(
            std::remove_if(
                g_visual_mounts.begin(),
                g_visual_mounts.end(),
                [](const VisualMountState& state)
                {
                    return !is_live_object(state.owner) &&
                           !is_live_object(state.clone);
                }),
            g_visual_mounts.end());
    }

    auto install_customization_hooks() -> bool
    {
        if (g_hooks_installed)
        {
            return true;
        }

        const auto requirements_target = resolve_compatible_hook_target(
            kDoesPartMeetRequirementsRva,
            kDoesPartMeetRequirementsBytes);

        const auto filter_target = resolve_compatible_hook_target(
            kFilterAssetDataByTagsRva,
            kFilterAssetDataByTagsBytes);

        if (requirements_target.address == 0 ||
            filter_target.address == 0)
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] REFUSED reason=unsupported-preexisting-customization-hook\n"));
            return false;
        }

        g_does_part_hook = std::make_unique<PLH::x64Detour>(
            requirements_target.address,
            reinterpret_cast<std::uint64_t>(
                &hook_does_part_meet_requirements),
            &g_does_part_trampoline);

        if (!g_does_part_hook->hook() ||
            g_does_part_trampoline == 0)
        {
            g_does_part_hook.reset();

            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] REFUSED reason=requirements-hook-install-failed\n"));
            return false;
        }

        g_filter_hook = std::make_unique<PLH::x64Detour>(
            filter_target.address,
            reinterpret_cast<std::uint64_t>(
                &hook_filter_asset_data_by_tags),
            &g_filter_trampoline);

        if (!g_filter_hook->hook() ||
            g_filter_trampoline == 0)
        {
            g_does_part_hook->unHook();
            g_does_part_hook.reset();
            g_filter_hook.reset();
            g_does_part_trampoline = 0;

            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] REFUSED reason=catalogue-hook-install-failed\n"));
            return false;
        }

        g_hooks_installed = true;

        RC::Output::send<RC::LogLevel::Verbose>(
            STR("[TheseArentTheHeadsYoureLookingFor] hook_compat requirements_chain={} catalogue_chain={}\n"),
            requirements_target.chained,
            filter_target.chained);

        return true;
    }

    class TheseArentTheHeadsYoureLookingForMod final
        : public RC::CppUserModBase
    {
    public:
        TheseArentTheHeadsYoureLookingForMod()
        {
            ModName = STR("TheseArentTheHeadsYoureLookingFor");
            ModVersion = STR("0.1.1-compat-test");
            ModDescription =
                STR("Expanded heads + Astromech support + cooperative customization hooks");
            ModAuthors = STR("Guillaume Rouge (jeez894)");
        }

        ~TheseArentTheHeadsYoureLookingForMod() override
        {
            if (g_filter_hook)
            {
                g_filter_hook->unHook();
            }

            if (g_does_part_hook)
            {
                g_does_part_hook->unHook();
            }

            g_filter_hook.reset();
            g_does_part_hook.reset();
            g_filter_trampoline = 0;
            g_does_part_trampoline = 0;
        }

        auto on_unreal_init() -> void override
        {
            const char* reason = "ok";

            if (!validate_runtime(g_runtime, reason))
            {
                RC::Output::send<RC::LogLevel::Error>(
                    STR("[TheseArentTheHeadsYoureLookingFor] REFUSED reason={}\n"),
                    RC::ensure_str(reason));
                return;
            }

            const FName asset_type_name(
                STR("CustomizationPartDefinition"),
                RC::Unreal::FNAME_Add);

            for (std::size_t i = 0; i < kTargetSpecs.size(); ++i)
            {
                g_target_ids[i] = FPrimaryAssetId{
                    FPrimaryAssetType{asset_type_name},
                    FName(kTargetSpecs[i].asset_name,
                          RC::Unreal::FNAME_Add),
                };
            }

            g_face_slot_tag = GameplayTag{
                FName(
                    STR("br.Customization.Slot.Character.Appearance.Humanoid.Head.Face.Mesh"),
                    RC::Unreal::FNAME_Find)
            };

            if (g_face_slot_tag.tag_name.IsNone())
            {
                RC::Output::send<RC::LogLevel::Error>(
                    STR("[TheseArentTheHeadsYoureLookingFor] REFUSED reason=face-slot-tag-not-found\n"));
                return;
            }

            std::size_t found_species_tags = 0;

            for (std::size_t i = 0; i < kSpeciesTagNames.size(); ++i)
            {
                g_species_tags[i] = GameplayTag{
                    FName(kSpeciesTagNames[i], RC::Unreal::FNAME_Find)
                };

                if (!g_species_tags[i].tag_name.IsNone())
                {
                    ++found_species_tags;

                    RC::Output::send<RC::LogLevel::Verbose>(
                        STR("[TheseArentTheHeadsYoureLookingFor] species_tag_found={}\n"),
                        kSpeciesTagNames[i]);
                }
            }

            // Do not hook the two shared customization entrypoints yet.
            // ZCUnlocked installs native detours on exactly the same RVAs and
            // refuses to start if we patch them first. Give other mods a short
            // startup window, then either chain behind their detours or hook
            // the pristine game functions when nobody else claimed them.
            g_found_species_tags = found_species_tags;
            g_hooks_pending = true;
            g_hook_install_deadline =
                std::chrono::steady_clock::now() +
                kHookCompatibilityGracePeriod;

            g_skeletal_mesh_component_class =
                RC::Unreal::UObjectGlobals::StaticFindObject<UClass*>(
                    nullptr,
                    nullptr,
                    STR("/Script/Engine.SkeletalMeshComponent"));

            g_native_visual_mount_ready =
                g_skeletal_mesh_component_class != nullptr;

            g_next_visual_scan =
                std::chrono::steady_clock::now();

            if (!g_native_visual_mount_ready)
            {
                RC::Output::send<RC::LogLevel::Warning>(
                    STR("[TheseArentTheHeadsYoureLookingFor] native_astromech_mount_disabled reason=SkeletalMeshComponent-class-not-found\n"));
            }

            RC::Output::send<RC::LogLevel::Verbose>(
                STR("[TheseArentTheHeadsYoureLookingFor] customization_hooks_deferred grace_ms=2000\n"));
        }

        auto on_update() -> void override
        {
            if (g_hooks_pending)
            {
                const auto now = std::chrono::steady_clock::now();

                const auto requirements_target = resolve_compatible_hook_target(
                    kDoesPartMeetRequirementsRva,
                    kDoesPartMeetRequirementsBytes);
                const auto filter_target = resolve_compatible_hook_target(
                    kFilterAssetDataByTagsRva,
                    kFilterAssetDataByTagsBytes);

                const bool external_hook_seen =
                    requirements_target.chained ||
                    filter_target.chained;

                if (external_hook_seen ||
                    now >= g_hook_install_deadline)
                {
                    g_hooks_pending = false;

                    if (install_customization_hooks())
                    {
                        RC::Output::send<RC::LogLevel::Verbose>(
                            STR("[TheseArentTheHeadsYoureLookingFor] READY face_targets=96 astromech_heads=39 native_astromech_mount={} customizer_mount={} cross_species_relaxation={} found_species_tags={} cooperative_hooks=true\n"),
                            g_native_visual_mount_ready,
                            g_native_visual_mount_ready,
                            kEnableCrossSpeciesRequirementRelaxation,
                            g_found_species_tags);
                    }
                }
            }

            for (std::size_t i = 0; i < kTargetSpecs.size(); ++i)
            {
                if (g_pending_catalogue[i].exchange(
                        false, std::memory_order_acq_rel))
                {
                    RC::Output::send<RC::LogLevel::Verbose>(
                        STR("[TheseArentTheHeadsYoureLookingFor] catalogue_face_added asset={}\n"),
                        kTargetSpecs[i].asset_name);
                }
            }

            if (g_native_visual_mount_ready)
            {
                const auto now =
                    std::chrono::steady_clock::now();

                if (now >= g_next_visual_scan)
                {
                    g_next_visual_scan =
                        now + kAstroVisualScanPeriod;

                    run_native_astromech_visual_scan();
                }
            }
        }
    };
