    auto bytes_match(std::uintptr_t base,
                     std::uintptr_t image_size,
                     std::uintptr_t rva,
                     const std::array<std::uint8_t, 16>& expected) -> bool
    {
        return rva + expected.size() <= image_size &&
               std::memcmp(reinterpret_cast<const void*>(base + rva),
                           expected.data(),
                           expected.size()) == 0;
    }

    auto validate_runtime(RuntimeIdentity& identity, const char*& reason) -> bool
    {
        const auto module = ::GetModuleHandleW(nullptr);
        if (!module)
        {
            reason = "main-module-not-found";
            return false;
        }

        const auto base = reinterpret_cast<std::uintptr_t>(module);
        const auto* dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(base);

        if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew <= 0)
        {
            reason = "invalid-dos-header";
            return false;
        }

        const auto* nt =
            reinterpret_cast<const IMAGE_NT_HEADERS64*>(
                base + static_cast<std::uintptr_t>(dos->e_lfanew));

        if (nt->Signature != IMAGE_NT_SIGNATURE ||
            nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC ||
            nt->FileHeader.Machine != IMAGE_FILE_MACHINE_AMD64 ||
            nt->FileHeader.TimeDateStamp != kExpectedPeTimestamp ||
            nt->OptionalHeader.SizeOfImage != kExpectedImageSize)
        {
            reason = "retail-pe-identity-mismatch";
            return false;
        }

        const auto image_size =
            static_cast<std::uintptr_t>(nt->OptionalHeader.SizeOfImage);

        // Do NOT validate the first bytes of DoesPartMeetRequirements or
        // FilterAssetDataByTags here. Another customization mod may already
        // have installed a compatible absolute detour there. The helper
        // functions we call directly must still be pristine.
        if (!bytes_match(base, image_size,
                         kGameplayTagContainerCopyCtorRva,
                         kGameplayTagContainerCopyCtorBytes) ||
            !bytes_match(base, image_size,
                         kGameplayTagContainerDtorRva,
                         kGameplayTagContainerDtorBytes) ||
            !bytes_match(base, image_size,
                         kGameplayTagContainerAddTagRva,
                         kGameplayTagContainerAddTagBytes))
        {
            reason = "helper-byte-mismatch";
            return false;
        }

        identity = {base, image_size};
        return true;
    }

    struct CompatibleHookTarget
    {
        std::uintptr_t address{};
        bool chained{};
    };

    auto is_executable_address(std::uintptr_t address) -> bool
    {
        if (address == 0)
        {
            return false;
        }

        MEMORY_BASIC_INFORMATION info{};
        if (::VirtualQuery(reinterpret_cast<const void*>(address),
                           &info, sizeof(info)) == 0 ||
            info.State != MEM_COMMIT ||
            (info.Protect & PAGE_GUARD) != 0 ||
            (info.Protect & PAGE_NOACCESS) != 0)
        {
            return false;
        }

        const DWORD executable =
            PAGE_EXECUTE |
            PAGE_EXECUTE_READ |
            PAGE_EXECUTE_READWRITE |
            PAGE_EXECUTE_WRITECOPY;

        return (info.Protect & executable) != 0;
    }

    auto resolve_compatible_hook_target(
        std::uintptr_t rva,
        const std::array<std::uint8_t, 16>& expected)
        -> CompatibleHookTarget
    {
        if (g_runtime.base == 0 ||
            rva + expected.size() > g_runtime.image_size)
        {
            return {};
        }

        const auto entry = g_runtime.base + rva;

        if (std::memcmp(reinterpret_cast<const void*>(entry),
                        expected.data(), expected.size()) == 0)
        {
            return {entry, false};
        }

        // ZCUnlocked's native detour writer uses exactly:
        //   FF 25 00 00 00 00
        //   <8-byte absolute destination>
        // If those bytes are present, hook the destination function instead.
        // Flow then becomes:
        // game -> ZCUnlocked hook -> our hook -> ZC trampoline -> original,
        // while our trampoline preserves ZCUnlocked's hook body.
        const auto* bytes =
            reinterpret_cast<const std::uint8_t*>(entry);

        if (bytes[0] == 0xFF &&
            bytes[1] == 0x25 &&
            bytes[2] == 0x00 &&
            bytes[3] == 0x00 &&
            bytes[4] == 0x00 &&
            bytes[5] == 0x00)
        {
            std::uintptr_t destination{};
            std::memcpy(&destination, bytes + 6, sizeof(destination));

            if (is_executable_address(destination))
            {
                return {destination, true};
            }
        }

        return {};
    }

    auto names_equal(const FName& a, const FName& b) -> bool
    {
        return std::memcmp(&a, &b, sizeof(FName)) == 0;
    }

    auto ids_equal(const FPrimaryAssetId& a, const FPrimaryAssetId& b) -> bool
    {
        return std::memcmp(&a, &b, sizeof(FPrimaryAssetId)) == 0;
    }

    auto container_has_exact_tag(const GameplayTagContainer& container,
                                 const GameplayTag& tag) -> bool
    {
        const auto contains = [&tag](const TArray<GameplayTag>& tags)
        {
            for (const auto& candidate : tags)
            {
                if (names_equal(candidate.tag_name, tag.tag_name))
                {
                    return true;
                }
            }
            return false;
        };

        return contains(container.gameplay_tags) ||
               contains(container.parent_tags);
    }

    auto array_contains(const TArray<FPrimaryAssetId>& ids,
                        const FPrimaryAssetId& target) -> bool
    {
        for (const auto& id : ids)
        {
            if (ids_equal(id, target))
            {
                return true;
            }
        }
        return false;
    }

    auto target_index(const FPrimaryAssetId& id) -> std::size_t
    {
        for (std::size_t i = 0; i < g_target_ids.size(); ++i)
        {
            if (ids_equal(id, g_target_ids[i]))
            {
                return i;
            }
        }
        return g_target_ids.size();
    }

    auto original_check_with_all_found_species(
        const FPrimaryAssetId& id,
        const GameplayTagContainer& owned_tags) -> bool
    {
        if (!kEnableCrossSpeciesRequirementRelaxation ||
            g_does_part_trampoline == 0)
        {
            return false;
        }

        alignas(GameplayTagContainer)
            std::array<std::byte, sizeof(GameplayTagContainer)> storage{};

        auto* adapted =
            reinterpret_cast<GameplayTagContainer*>(storage.data());

        const auto copy_ctor =
            reinterpret_cast<GameplayTagContainerCopyCtorFunction>(
                g_runtime.base + kGameplayTagContainerCopyCtorRva);

        const auto destructor =
            reinterpret_cast<GameplayTagContainerDtorFunction>(
                g_runtime.base + kGameplayTagContainerDtorRva);

        const auto add_tag =
            reinterpret_cast<GameplayTagContainerAddTagFunction>(
                g_runtime.base + kGameplayTagContainerAddTagRva);

        const auto original =
            reinterpret_cast<DoesPartMeetRequirementsFunction>(
                g_does_part_trampoline);

        copy_ctor(adapted, &owned_tags);

        for (const auto& species_tag : g_species_tags)
        {
            if (!species_tag.tag_name.IsNone())
            {
                add_tag(adapted, &species_tag);
            }
        }

        const bool result = original(&id, adapted);
        destructor(adapted);
        return result;
    }

    auto hook_does_part_meet_requirements(
        const FPrimaryAssetId* id,
        const GameplayTagContainer* owned_tags) -> bool
    {
        const auto original =
            reinterpret_cast<DoesPartMeetRequirementsFunction>(
                g_does_part_trampoline);

        if (!original || !id || !owned_tags)
        {
            return false;
        }

        if (original(id, owned_tags))
        {
            return true;
        }

        // Exact face-menu targets are deliberately forced compatible. This removes
        // Species.* / Name.* top-level locks, including Species.Astromech.
        // Astromech CPDs themselves are untouched, so their Mesh and
        // MaterialTexture fragments remain vanilla (including Crystaline).
        if (target_index(*id) < kTargetSpecs.size())
        {
            return true;
        }

        // Experimental broad unlock: retry every OTHER customization part
        // against the game's own requirement checker while pretending that
        // every species tag we could actually find is owned. This can expose
        // cross-species hair, beard, makeup and skin-color parts while keeping
        // the normal slot/body/etc. checks.
        return original_check_with_all_found_species(*id, *owned_tags);
    }

    auto hook_filter_asset_data_by_tags(
        void* subsystem,
        const GameplayTagContainer* owned_tags,
        TArray<FPrimaryAssetId>* output) -> void
    {
        const auto original =
            reinterpret_cast<FilterAssetDataByTagsFunction>(
                g_filter_trampoline);

        if (!original)
        {
            return;
        }

        // Keep the normal catalogue generation. Because DoesPartMeetRequirements
        // is hooked above, normal catalogue entries may already gain relaxed
        // cross-species compatibility without us injecting them manually.
        original(subsystem, owned_tags, output);

        if (!owned_tags || !output)
        {
            return;
        }

        // CRITICAL safety gate: hardcoded HEAD CPDs are manually injected only
        // while the game is building the Humanoid Face Mesh catalogue.
        // They therefore cannot leak into hair/beard/makeup/tattoo/skin menus.
        if (!container_has_exact_tag(*owned_tags, g_face_slot_tag))
        {
            return;
        }

        for (std::size_t i = 0; i < g_target_ids.size(); ++i)
        {
            if (array_contains(*output, g_target_ids[i]))
            {
                continue;
            }

            output->Add(g_target_ids[i]);

            if (!g_seen_catalogue[i].exchange(
                    true, std::memory_order_relaxed))
            {
                g_pending_catalogue[i].store(
                    true, std::memory_order_release);
            }
        }
    }


