        const FName wanted_name(wanted, RC::Unreal::FNAME_Find);

        if (wanted_name.IsNone())
        {
            return false;
        }

        for (std::int32_t index = 0;
             index < count;
             ++index)
        {
            FName candidate{};

            if (get_bone_name(component,
                              index,
                              candidate) &&
                names_equal(candidate, wanted_name))
            {
                out = candidate;
                return true;
            }
        }

        return false;
    }

