    auto create_skeletal_mesh_component(UObject* owner,
                                        UObject* source,
                                        VisualOwnerKind kind)
        -> UObject*
    {
        if (!is_live_object(owner) ||
            !is_live_object(source) ||
            g_skeletal_mesh_component_class == nullptr)
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=invalid-input\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        auto* add_component =
            find_function(owner,
                          STR("AddComponentByClass"));

        if (add_component == nullptr)
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=AddComponentByClass-not-found\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        auto* get_world_transform =
            find_function(source,
                          STR("K2_GetComponentToWorld"));

        if (get_world_transform == nullptr)
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=K2_GetComponentToWorld-not-found\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        ReflectedCall transform_call{
            get_world_transform};

        source->ProcessEvent(
            get_world_transform,
            transform_call.data());

        ReflectedCall add_call{
            add_component};

        const bool manual_attachment = true;
        const bool deferred_finish = false;

        if (!set_input(add_component,
                       add_call.data(),
                       0,
                       g_skeletal_mesh_component_class))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=set-class-param\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        if (!set_input(add_component,
                       add_call.data(),
                       1,
                       manual_attachment))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=set-manual-attachment-param\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        // Mirror the exact Lua prototype that worked:
        // owner:AddComponentByClass(
        //     SkeletalMeshComponentClass,
        //     true,
        //     source:K2_GetComponentToWorld(),
        //     false)
        //
        // v0.7.3 fix: input_property_at() now retains const-reference
        // parameters. This is required for RelativeTransform.
        if (!copy_return_to_input(
                get_world_transform,
                transform_call.data(),
                add_component,
                add_call.data(),
                2))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=copy-relative-transform\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        if (!set_input(add_component,
                       add_call.data(),
                       3,
                       deferred_finish))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=set-deferred-param\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        owner->ProcessEvent(
            add_component,
            add_call.data());

        UObject* result{};

        if (!read_return(
                add_component,
                add_call.data(),
                result))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=read-return\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        if (!is_live_object(result))
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_create_failed owner={} stage=returned-null\n"),
                visual_owner_label(kind));
            return nullptr;
        }

        RC::Output::send<RC::LogLevel::Verbose>(
            STR("[TheseArentTheHeadsYoureLookingFor] astro_clone_constructed owner={}\n"),
            visual_owner_label(kind));

        return result;
    }

