    struct ReflectedCall
    {
        UFunction* function{};
        std::size_t byte_size{};
        std::vector<std::max_align_t> storage{};

        explicit ReflectedCall(UFunction* fn)
            : function(fn)
        {
            if (function == nullptr)
            {
                return;
            }

            byte_size =
                static_cast<std::size_t>(
                    function->GetParmsSize());

            if (byte_size == 0)
            {
                return;
            }

            const auto element_size =
                sizeof(std::max_align_t);

            storage.resize(
                (byte_size + element_size - 1) /
                element_size);

            function->InitializeStruct(storage.data());
        }

        ~ReflectedCall()
        {
            if (function != nullptr &&
                byte_size != 0 &&
                !storage.empty())
            {
                function->DestroyStruct(storage.data());
            }
        }

        auto data() -> void*
        {
            return storage.empty()
                       ? nullptr
                       : storage.data();
        }
    };

    auto input_property_at(UFunction* function,
                           std::size_t wanted_index)
        -> FProperty*
    {
        if (function == nullptr)
        {
            return nullptr;
        }

        std::size_t current_index = 0;

        for (FProperty* property :
             RC::Unreal::TFieldRange<FProperty>(
                 function,
                 RC::Unreal::EFieldIterationFlags::IncludeDeprecated))
        {
            if (!property->HasAnyPropertyFlags(
                    RC::Unreal::EPropertyFlags::CPF_Parm))
            {
                continue;
            }

            if (property->HasAnyPropertyFlags(
                    RC::Unreal::EPropertyFlags::CPF_ReturnParm))
            {
                continue;
            }

            // IMPORTANT:
            // UE reflection marks const-reference inputs such as
            // AddComponentByClass(..., const FTransform& RelativeTransform, ...)
            // as OutParm + ConstParm/ReferenceParm.  v0.7.2 skipped every
            // OutParm, so RelativeTransform vanished from the input list and
            // input index 2 incorrectly resolved to the final bool parameter.
            //
            // Skip only PURE output parameters. Keep const-reference inputs.
            const bool is_out =
                property->HasAnyPropertyFlags(
                    RC::Unreal::EPropertyFlags::CPF_OutParm);

            const bool is_const =
                property->HasAnyPropertyFlags(
                    RC::Unreal::EPropertyFlags::CPF_ConstParm);

            if (is_out && !is_const)
            {
                continue;
            }

            if (current_index == wanted_index)
            {
                return property;
            }

            ++current_index;
        }

        return nullptr;
    }

    template <typename T>
    auto set_input(UFunction* function,
                   void* params,
                   std::size_t index,
                   const T& value) -> bool
    {
        if (params == nullptr)
        {
            return false;
        }

        auto* property = input_property_at(function, index);

        if (property == nullptr)
        {
            return false;
        }

        auto* destination =
            property->ContainerPtrToValuePtr<void>(params);

        if (destination == nullptr)
        {
            return false;
        }

        property->CopyCompleteValue(destination, &value);
        return true;
    }

    template <typename T>
    auto read_return(UFunction* function,
                     void* params,
                     T& out) -> bool
    {
        if (function == nullptr || params == nullptr)
        {
            return false;
        }

        auto* property = function->GetReturnProperty();

        if (property == nullptr)
        {
            return false;
        }

        auto* source =
            property->ContainerPtrToValuePtr<void>(params);

        if (source == nullptr)
        {
            return false;
        }

        property->CopyCompleteValue(&out, source);
        return true;
    }

    auto copy_return_to_input(UFunction* source_function,
                              void* source_params,
                              UFunction* target_function,
                              void* target_params,
                              std::size_t target_input_index) -> bool
    {
        if (source_function == nullptr ||
            source_params == nullptr ||
            target_function == nullptr ||
            target_params == nullptr)
        {
            return false;
        }

        auto* source_property =
            source_function->GetReturnProperty();

        auto* target_property =
            input_property_at(
                target_function,
                target_input_index);

        if (source_property == nullptr ||
            target_property == nullptr)
        {
            return false;
        }

        // We intentionally do not interpret FTransform here. The source
        // K2_GetComponentToWorld return property and AddComponentByClass
        // RelativeTransform input property are both the engine's FTransform
        // script struct, so let Unreal's reflected property implementation
        // perform the copy.
        if (source_property->GetSize() !=
            target_property->GetSize())
        {
            RC::Output::send<RC::LogLevel::Error>(
                STR("[TheseArentTheHeadsYoureLookingFor] reflected-copy-size-mismatch source_size={} target_size={}\n"),
                source_property->GetSize(),
                target_property->GetSize());
            return false;
        }

        auto* source_value =
            source_property->ContainerPtrToValuePtr<void>(
                source_params);

        auto* target_value =
            target_property->ContainerPtrToValuePtr<void>(
                target_params);

        if (source_value == nullptr ||
            target_value == nullptr)
        {
            return false;
        }

        target_property->CopyCompleteValue(
            target_value,
            source_value);

        return true;
    }

